# Copy to .env for local runs. NEVER put the real DAY1_SALT in a committed file.
# The grader supplies it on the command line:
#   DAY1_SALT=<your-team-salt> docker compose up -d --build

DAY1_SALT=replace-me-with-the-salt-on-your-team-slip

PORT=8080
DATABASE_URL=postgres://nascon:nascon@db:5432/nascon
REDIS_URL=redis://redis:6379

# Signing key for the RBAC JWTs. Unrelated to DAY1_SALT.
JWT_SECRET=nascon-dev-jwt-secret

MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=nasconminio
MINIO_SECRET_KEY=nasconminio

NODE_ENV=production
